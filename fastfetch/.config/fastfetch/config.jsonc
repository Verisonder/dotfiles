{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/sr.txt",
        "color": { "1": "blue", "2": "white" },
        "padding": { "top": 2, "left": 3, "right": 3 }
    },
    "modules": [
        "break",
        { "type": "custom", "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐" },
        { "type": "host",    "key": " PC ", "keyColor": "blue",        "keySeparator": "" },
        { "type": "cpu",     "key": "│ ├ ", "keyColor": "blue",        "keySeparator": "" },
        { "type": "gpu",     "key": "│ ├󰍛 ", "keyColor": "blue",        "keySeparator": "" },
        { "type": "memory",  "key": "│ ├󰍛 ", "keyColor": "blue",        "keySeparator": "" },
        { "type": "disk",    "key": "└ └ ", "keyColor": "blue",        "keySeparator": "" },
        { "type": "custom",  "format": "\u001b[90m└────────────────────────────────────────────────────┘" },
        "break",
        { "type": "custom",  "format": "\u001b[90m┌──────────────────────Software──────────────────────┐" },
        { "type": "os",      "key": "󰌽 OS ", "keyColor": "light_black", "keySeparator": "", "format": "SondeR Linux 1 (WEIW SR Edition) x86_64" },
        { "type": "kernel",  "key": "│ ├ ", "keyColor": "light_black", "keySeparator": "" },
        { "type": "bios",    "key": "│ ├ ", "keyColor": "light_black", "keySeparator": "" },
        { "type": "packages","key": "│ ├󰏖 ", "keyColor": "light_black", "keySeparator": "" },
        { "type": "shell",   "key": "└ └ ", "keyColor": "light_black", "keySeparator": "" },
        "break",
        { "type": "de",      "key": " DE ", "keyColor": "blue",        "keySeparator": "" },
        { "type": "lm",      "key": "│ ├ ", "keyColor": "blue",        "keySeparator": "" },
        { "type": "wm",      "key": "│ ├ ", "keyColor": "blue",        "keySeparator": "" },
        { "type": "wmtheme", "key": "│ ├󰉼 ", "keyColor": "blue",        "keySeparator": "" },
        { "type": "terminal","key": "└ └ ", "keyColor": "blue",        "keySeparator": "" },
        { "type": "custom",  "format": "\u001b[90m└────────────────────────────────────────────────────┘" },
        "break",
        { "type": "custom",  "format": "\u001b[90m┌────────────────────Uptime / Age / DT───────────────┐" },
        { "type": "command", "key": "  OS Age ", "keyColor": "magenta", "keySeparator": "", "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days" },
        { "type": "uptime",  "key": "  Uptime ", "keyColor": "magenta", "keySeparator": "" },
        { "type": "datetime","key": "  DateTime ", "keyColor": "magenta", "keySeparator": "" },
        { "type": "custom",  "format": "\u001b[90m└────────────────────────────────────────────────────┘" },
        { "type": "colors",  "paddingLeft": 2, "symbol": "circle" }
    ]
}
