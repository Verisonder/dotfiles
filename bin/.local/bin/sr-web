#!/usr/bin/env python3
# sr-web — serves ~/.cache/sr-web on http://127.0.0.1:47300 for the browser start page
# (Bonjourr imports bonjourr.css from here; wallpaper.jpg links to the current wallpaper).
# Localhost only, never cached, so theme and wallpaper changes show on the next new tab.
import os, functools, http.server
ROOT = os.path.expanduser("~/.cache/sr-web")
os.makedirs(ROOT, exist_ok=True)

class Handler(http.server.SimpleHTTPRequestHandler):
    def end_headers(self):
        self.send_header("Cache-Control", "no-store")
        self.send_header("Access-Control-Allow-Origin", "*")
        super().end_headers()
    def log_message(self, *a):
        pass

http.server.ThreadingHTTPServer(("127.0.0.1", 47300),
    functools.partial(Handler, directory=ROOT)).serve_forever()
